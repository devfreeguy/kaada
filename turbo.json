{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "API_HOST",
    "WEB_URL",
    "CORS_ORIGINS",
    "LOG_LEVEL",
    "DATABASE_URL",
    "DATABASE_DIRECT_URL",
    "DATABASE_POOL_MAX",
    "DATABASE_POOL_TIMEOUT_MS",
    "AGENT_INTERPRETER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "test": {
      "dependsOn": ["^build", "generate"]
    }
  }
}
