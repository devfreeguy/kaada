# Kaada API: production environment. Copy to /opt/apps/kaada/.env on the server, fill in every REPLACE, chmod 600.
#
# FORMAT RULES (this file is read by `docker run --env-file` AND by `docker compose`):
#   - NO quotes anywhere. Docker's --env-file keeps quotes as part of the value.
#   - NO inline comments. A "#" after a value becomes part of the value. Comments go on their own lines.
#   - NO multi-line values and NO "$" in values (compose would try to expand it). Generate secrets with the commands shown.
#   - Flags are exactly true or false (anything else, including yes, is refused at start-up).
#
# The API validates all of this at boot (packages/config/src/env.ts) and exits with the reason if something is wrong.

# ── Server ──────────────────────────────────────────────────────────────────
# Required in production: NODE_ENV=production. The mock interpreter and mock FX provider are refused there.
NODE_ENV=production
# The compose file pins PORT=3005 and API_HOST=0.0.0.0 as well; keep them in step with the 127.0.0.1:3005 mapping.
PORT=3005
API_HOST=0.0.0.0
# Public URL of the Kaada web app (default http://localhost:3000, so set it).
WEB_URL=https://kaada.xyz
# Comma-separated browser origins allowed to call the API. Default: empty.
CORS_ORIGINS=https://kaada.xyz
# fatal | error | warn | info | debug | trace | silent. Default: info
LOG_LEVEL=info

# ── Database and Redis ─────────────────────────────────────────────────────
# The shared Postgres on the alpha network is NOT behind a pooler, so the runtime URL and the direct (migration) URL are the
# SAME connection: postgres:5432/kaada_db. The migrator reads DATABASE_DIRECT_URL first, then DATABASE_URL.
# Required. If the password contains URL-special characters (: / ? # @ %), percent-encode them.
DATABASE_URL=postgresql://kaada_user:REPLACE@postgres:5432/kaada_db
DATABASE_DIRECT_URL=postgresql://kaada_user:REPLACE@postgres:5432/kaada_db
# Shared Redis (plaintext on the alpha network, requirepass). Used only for rate limiting, with the fixed key prefix kaada:rl:.
# Plain redis:// means no TLS (TLS is used only for rediss://). REQUIRED in production once wallets or recovery are on.
REDIS_URL=redis://:REPLACE@redis:6379

# ── Agent and pricing ───────────────────────────────────────────────────────
# none | mock | groq. Default: none. mock is refused in production.
AGENT_INTERPRETER=groq
# Required when AGENT_INTERPRETER=groq.
GROQ_API_KEY=REPLACE
# none | mock | textile. Default: none. mock is refused in production.
FX_PROVIDER=textile
# Required when FX_PROVIDER=textile, and must start with tx_live_
TEXTILE_LIVE_API_KEY=REPLACE

# ── Wallets and passkeys ────────────────────────────────────────────────────
# none | kernel. Default: none. Telegram chat (below) needs kernel.
WALLET_PROVIDER=kernel
# Must be https in production with the kernel wallet. Default: https://forno.celo.org
CELO_RPC_URL=https://forno.celo.org
# celo-mainnet is the ONLY value production accepts. Default: celo-mainnet
WALLET_NETWORK=celo-mainnet
# The domain passkeys are bound to, and the exact origin of the web app that registers them (must be https in production, and
# on the RP ID domain). Required with WALLET_PROVIDER=kernel.
PASSKEY_RP_ID=kaada.xyz
PASSKEY_ORIGIN=https://kaada.xyz
# Mixed into every PIN hash. Required in production with the kernel wallet, at least 32 characters. Generate: openssl rand -hex 32
# WARNING: changing it later makes every existing PIN unverifiable. Set it once and keep it.
PIN_PEPPER=REPLACE

# ── Payment execution (can move funds; leave false until you mean it) ───────
# Default: false. true requires BUNDLER_URL, EXECUTION_SECRET_KEY, WALLET_PROVIDER=kernel, FX_PROVIDER=textile and the passkey settings.
EXECUTION_ENABLED=false
# Required only when EXECUTION_ENABLED=true or RECOVERY_ENABLED=true. Leave it out (do not set it empty: an empty value is not
# a valid URL and stops the API starting). It may carry an API key, so treat it as a secret.
# BUNDLER_URL=https://REPLACE
# Least native CELO (wei) a wallet must hold for network fees. Default: 50000000000000000 (0.05 CELO)
EXECUTION_MIN_NATIVE_WEI=50000000000000000
# AES-256-GCM key for stored claim tokens and session keys: 32 random bytes as base64. Generate: openssl rand -base64 32
# Required in production with the kernel wallet and Textile. WARNING: changing it makes everything already encrypted with the
# old key unreadable. To rotate, raise the version and move the OLD key to EXECUTION_SECRET_KEY_PREVIOUS; never just replace it.
EXECUTION_SECRET_KEY=REPLACE
# Default: 1
EXECUTION_SECRET_KEY_VERSION=1
# Only while rotating: the previous base64 key.
# EXECUTION_SECRET_KEY_PREVIOUS=

# ── Kaada platform / agent wallet ────────────────────────────────────────────
# One dedicated EOA: Kaada's public identity on Celo (hackathon agent, future service-fee recipient, platform-owned transactions). It is
# NOT a user wallet, a Kernel, the recovery relayer or a paymaster, and user payments never go through it. Required in production.
# The key is a file mounted read-only by deploy/compose.yml from /opt/apps/kaada/secrets/platform-agent.key; never an env variable.
PLATFORM_WALLET_KEY_FILE=/run/secrets/platform-agent.key
# Its PUBLIC address (print it with deploy/scripts/platform-address.mjs). At startup the key must derive to exactly this address, or the
# API refuses to start. Every transaction this wallet sends carries the Celo attribution tag.
PLATFORM_WALLET_ADDRESS=REPLACE

# ── Account recovery (needs the mainnet contracts listed in packages/config/src/deployments.ts) ──────────
# Recovery needs: the registered email, the Recovery Code, a code from the person's authenticator app, and a 72-hour delay. No server
# key can approve a recovery. Until `celo-mainnet` has real addresses in deployments.ts, RECOVERY_ENABLED=true REFUSES TO START (by design;
# it never falls back to Sepolia or development addresses).
RECOVERY_ENABLED=true
RECOVERY_NETWORK=celo-mainnet
# The recovery RELAYER's key: a hot operational key that submits recovery initiation and pays its gas. It does not have the Recovery
# Code, cannot forge or cancel a recovery and controls no user funds. Mounted READ-ONLY by deploy/compose.yml from
# /opt/apps/kaada/secrets/recovery-relayer.key (one file, 0x-prefixed 32-byte hex). Never put the key in this file or in an image.
# At startup its address must equal the relayer recorded for this network in deployments.ts, or the API will not start.
RECOVERY_RELAYER_KEY_FILE=/run/secrets/recovery-relayer.key
# 32 random bytes as base64 (keys the email-code hash). Generate: openssl rand -base64 32
RECOVERY_CHALLENGE_SECRET=REPLACE
# 32 random bytes as base64: encrypts each wallet's authenticator-app secret at rest. Its own key: not EXECUTION_SECRET_KEY, not
# PIN_PEPPER. Generate: openssl rand -base64 32
RECOVERY_TOTP_SECRET_KEY=REPLACE
RECOVERY_TOTP_SECRET_KEY_VERSION=1
# Only while rotating: bump the version and keep the old key as PREVIOUS.
# RECOVERY_TOTP_SECRET_KEY_PREVIOUS=
# Email delivery for recovery. Production needs SMTP and a sender. Use the discrete settings: no URL, so a password containing
# # $ & ^ { } @ : / % needs no encoding. security=starttls (port 587) REQUIRES the STARTTLS upgrade and fails the send otherwise;
# security=tls (usually port 465) is implicit TLS.
RECOVERY_SMTP_HOST=smtp.example.com
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_USER=REPLACE
RECOVERY_SMTP_SECURITY=starttls
# The password is a FILE (preferred over putting it here): /opt/apps/kaada/secrets/recovery-smtp-password on the host (mode 400, owner
# 1000:1000), mounted read-only by deploy/compose.yml. The whole file is the password; only its trailing newline is removed.
# RECOVERY_SMTP_PASSWORD is the alternative and is mutually exclusive with the file; RECOVERY_SMTP_URL (the legacy single-URL form,
# deprecated) is mutually exclusive with ALL of these settings: configuring both stops startup.
RECOVERY_SMTP_PASSWORD_FILE=/run/secrets/recovery-smtp-password
# UNQUOTED, even though it contains spaces and angle brackets: env_file keeps quotes as part of the value.
RECOVERY_EMAIL_FROM=Kaada Security <security@kaada.xyz>
# The most native CELO (wei) the platform may send an account so a recovery is not stopped by an empty wallet. Default: 0 (off)
RECOVERY_GAS_TOPUP_MAX_WEI=0
# Default: false
DEVICE_KEY_ROOTS_ENABLED=false
# Enable device attestation by naming the trusted apps. Optional.
# ATTESTATION_ANDROID_APPS=
# ATTESTATION_IOS_APP_IDS=

# ── Telegram ────────────────────────────────────────────────────────────────
# With a token alone the bot can only send. With the webhook secret too people can talk to Kaada in Telegram (needs
# WALLET_PROVIDER=kernel). The secret is 16 to 256 characters of A-Z a-z 0-9 _ -  Generate: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=REPLACE
TELEGRAM_WEBHOOK_SECRET=REPLACE

# Not read by the API: TELEGRAM_WEBHOOK_URL is only used by the `telegram:webhook` script when you register the webhook
# (https://api.kaada.xyz/api/v1/channels/telegram/webhook). See deploy/README.md.
