# Copy to .env and adjust. Loaded by the API at startup (apps/api).
NODE_ENV=development
PORT=4000
API_HOST=0.0.0.0
WEB_URL=http://localhost:3000
# Comma-separated. Defaults to WEB_URL when empty.
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL / Neon). Replace the placeholders with your own connection strings.
# Runtime: Neon pooled connection (host contains "-pooler"). Required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/kaada?sslmode=verify-full
# Migrations only: Neon direct (non-pooled) connection. Optional; falls back to DATABASE_URL.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/kaada?sslmode=verify-full
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_MS=10000

# Agent. Which interpreter turns messages into structured intents:
#   none - agent disabled (default)    mock - scripted dev fixtures (never in production)
#   groq - Groq LLM (requires GROQ_API_KEY)
AGENT_INTERPRETER=none

# Price source for routing.
#   none - no pricing, the agent stops at ROUTING_REQUIRED (default)
#   mock - MOCK / DEVELOPMENT fixture rates, not real prices (never in production)
#   textile - Textile RFQ (quote only); see docs/textile.md
FX_PROVIDER=none

# Textile (used when FX_PROVIDER=textile). Environments are separate from the blockchain network:
#   live - mainnet corridors incl. Celo 42220 (TEXTILE_LIVE_API_KEY, tx_live_...). Required for Kaada.
#   test - ONLY chains 97 / 84532, never Celo; used by the sandbox smoke script, refused by the app.
TEXTILE_ENV=live
TEXTILE_LIVE_API_KEY=
TEXTILE_TEST_API_KEY=
TEXTILE_API_URL=https://api.textilecredit.com
TEXTILE_TIMEOUT_MS=8000
CELO_NETWORK=mainnet
CELO_CHAIN_ID=42220

# Wallet stack (docs/wallet-architecture.md). none disables wallets; kernel = ZeroDev Kernel v3.3 with a
# passkey root. Read-only in this build: nothing signs or moves funds.
WALLET_PROVIDER=none
CELO_RPC_URL=https://forno.celo.org
# WebAuthn relying party: the domain passkeys are bound to, and the exact web origin allowed
# (an https origin on that domain in production).
PASSKEY_RP_ID=
PASSKEY_ORIGIN=

# Groq (used when AGENT_INTERPRETER=groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=api_key
# Must support strict structured output (json_schema): openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=8000
