{
  "name": "@kaada/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"test/*.test.ts\"",
    "test:integration": "node --import tsx --test \"test/integration/*.test.ts\""
  },
  "dependencies": {
    "@kaada/config": "workspace:*",
    "@kaada/database": "workspace:*",
    "@kaada/domain": "workspace:*",
    "@kaada/logger": "workspace:*",
    "@kaada/schemas": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "nestjs-pino": "^5.3.1",
    "pino": "catalog:",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kaada/eslint-config": "workspace:*",
    "@kaada/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
