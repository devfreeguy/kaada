{
  "name": "@kaada/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"test/*.test.ts\"",
    "telegram:webhook": "node --import tsx scripts/telegram-webhook.ts",
    "test:security": "node scripts/security-regression.mjs",
    "test:integration": "node --import tsx --test \"test/integration/*.test.ts\"",
    "smoke:groq": "node --import tsx scripts/groq-smoke.ts",
    "smoke:textile": "node --import tsx scripts/smoke-textile.ts",
    "smoke:wallet": "node --import tsx scripts/wallet-smoke.ts",
    "smoke:setup": "node --import tsx scripts/setup-smoke.ts",
    "demo:authorize": "node --import tsx scripts/authorize-demo.ts",
    "conversation:review": "node --import tsx scripts/conversation-review.ts"
  },
  "dependencies": {
    "@kaada/attestation": "workspace:*",
    "@kaada/blockchain": "workspace:*",
    "@kaada/config": "workspace:*",
    "@kaada/contracts": "workspace:*",
    "@kaada/database": "workspace:*",
    "@kaada/domain": "workspace:*",
    "@kaada/logger": "workspace:*",
    "@kaada/schemas": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.3",
    "groq-sdk": "^1.6.0",
    "ioredis": "5.8.2",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "7.0.9",
    "pino": "catalog:",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kaada/eslint-config": "workspace:*",
    "@kaada/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@types/node": "catalog:",
    "@types/nodemailer": "7.0.2",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "viem": "2.57.4"
  }
}
