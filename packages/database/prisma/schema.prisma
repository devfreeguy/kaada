// Kaada persistence schema (Prisma 7).
//
// Conventions
// - Primary keys are PostgreSQL UUIDs generated by the application (randomUUID, UUIDv4).
//   There is intentionally no @default on ids.
// - Money is NEVER Float/Decimal. Every canonical amount is a String holding a non-negative
//   integer in the asset's smallest unit (kobo, cents, 10^-6 USDC, wei, ...). Asset.decimals says
//   how to interpret it. A CHECK constraint in the `money_and_asset_constraints` migration enforces
//   the digits-only format, and `src/schema.test.ts` guards against Float/Decimal in this file.
// - Datasource URLs live in prisma.config.ts, not here (Prisma 7).
// - Every foreign key is declared with an explicit onDelete. Financial history uses Restrict.
// - Constraints Prisma cannot express (partial unique indexes, CHECKs) live in the hand-written
//   migration `money_and_asset_constraints`; see docs/database.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum IdentityType {
  TELEGRAM
  WHATSAPP
  PHONE
  EMAIL
  DISCORD
  X
}

enum ChannelType {
  TELEGRAM
  WHATSAPP
  WEB
  DISCORD
  X
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum IntentType {
  SEND
  CONVERT
  QUOTE
  BALANCE
  TRANSACTION_STATUS
  HELP
  UNKNOWN
}

enum IntentStatus {
  DRAFT
  AWAITING_DETAILS
  RESOLVED
  QUOTING
  AWAITING_CONFIRMATION
  EXECUTING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum AmountMode {
  EXACT_INPUT
  EXACT_OUTPUT
}

enum RecipientType {
  KAADA_USER
  USERNAME
  TELEGRAM_USER
  PHONE_NUMBER
  WALLET_ADDRESS
  SAVED_BENEFICIARY
  EXTERNAL_PAYMENT_ADDRESS
}

enum AssetKind {
  FIAT
  USD_STABLECOIN
  LOCAL_STABLECOIN
  CRYPTO
  NATIVE_ASSET
}

enum ProviderType {
  FX
  RAMP
  WALLET
  RPC
  MULTI_SERVICE
}

enum WalletType {
  EMBEDDED
  EXTERNAL
}

enum WalletStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  REVOKED
  RECOVERY_REQUIRED
}

enum WalletDeployment {
  NOT_APPLICABLE
  COUNTERFACTUAL
  DEPLOYING
  DEPLOYED
}

enum PermissionStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

enum WalletSetupStatus {
  PENDING
  COMPLETED
  REVOKED
}

enum AuthorizationSessionStatus {
  PENDING
  AUTHORIZED
  EXPIRED
  CANCELLED
}

enum PaymentAuthorizationStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

enum FirmQuoteAttemptStatus {
  REQUESTING
  QUOTED
  UNUSABLE
  EXPIRED
  FAILED
  TIMED_OUT
}

enum PasskeyChallengePurpose {
  REGISTRATION
  AUTHENTICATION
}

enum CapabilityType {
  QUOTE
  SWAP
  EXACT_INPUT
  EXACT_OUTPUT
  ON_RAMP
  OFF_RAMP
  BANK_PAYOUT
  CONDITIONAL_EXECUTION
}

enum RouteStatus {
  CREATED
  VALID
  EXPIRED
  SELECTED
  INVALID
}

enum RouteStepType {
  TRANSFER
  SWAP
  BRIDGE
  ON_RAMP
  OFF_RAMP
  BANK_PAYOUT
}

enum ExecutionStatus {
  CREATED
  PREPARING
  READY
  BLOCKED
  AWAITING_CONFIRMATION
  CONFIRMED
  EXECUTING
  SETTLING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum TransactionType {
  APPROVAL
  TRANSFER
  SWAP
  CONTRACT_CALL
  RAMP
}

enum TransactionStatus {
  CREATED
  SIGNING
  SUBMITTED
  CONFIRMING
  CONFIRMED
  FAILED
  REPLACED
}

enum RampType {
  ON_RAMP
  OFF_RAMP
}

enum RampStatus {
  CREATED
  REDIRECT_REQUIRED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

// ─────────────────────── Users & identity ───────────────────────

model User {
  id          String   @id @db.Uuid
  username    String?  @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  identities       Identity[]
  sessions         Session[]
  wallets          Wallet[]
  conversations    Conversation[]
  ownedRecipients  Recipient[]    @relation("RecipientOwner")
  linkedRecipients Recipient[]    @relation("RecipientLinkedUser")
  intents          Intent[]
  executions       Execution[]
  rampSessions     RampSession[]
  auditEvents      AuditEvent[]

  passkeyCredentials   PasskeyCredential[]
  passkeyChallenges    PasskeyChallenge[]
  delegatedPermissions DelegatedPermission[]
  walletSetupSessions  WalletSetupSession[]

  transactionPin        TransactionPinSecurity?
  authorizationSessions AuthorizationSession[]
  paymentAuthorizations PaymentAuthorization[]
  firmQuoteAttempts     FirmQuoteAttempt[]
}

/// An external identity (Telegram account, phone, email, ...) attached to one Kaada user.
model Identity {
  id         String       @id @db.Uuid
  userId     String       @db.Uuid
  type       IdentityType
  externalId String
  username   String?
  phone      String?
  metadata   Json?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, externalId])
  @@index([userId])
}

/// Web/auth session. Only a hash of the session token is stored.
model Session {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A wallet linked to a user. A row here does NOT imply Kaada custody, and never holds a private key,
/// seed, session secret or provider credential: identifiers only.
///
/// An EMBEDDED wallet is a smart account whose root authority is the user's passkey. Its address is
/// derived deterministically (counterfactual) and may be null only while PROVISIONING. See
/// docs/wallet-architecture.md and the manual migration 20261014000001 (one non-revoked EMBEDDED wallet
/// per user and chain; ACTIVE requires an address).
model Wallet {
  id                String           @id @db.Uuid
  userId            String           @db.Uuid
  chainId           Int
  address           String?
  label             String?
  isPrimary         Boolean          @default(false)
  type              WalletType       @default(EXTERNAL)
  status            WalletStatus     @default(ACTIVE)
  deployment        WalletDeployment @default(NOT_APPLICABLE)
  provider          String?
  providerAccountId String?
  statusReason      String?
  provisionedAt     DateTime?        @db.Timestamptz(3)
  metadata          Json?
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  delegatedPermissions  DelegatedPermission[]
  authorizationSessions AuthorizationSession[]
  paymentAuthorizations PaymentAuthorization[]
  firmQuoteAttempts     FirmQuoteAttempt[]
  executions            Execution[]

  @@unique([chainId, address])
  @@index([userId])
}

/// A user's passkey: PUBLIC data only. The private key stays in the user's authenticator.
model PasskeyCredential {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  credentialId String    @unique
  publicKeyX   String    @db.Char(64)
  publicKeyY   String    @db.Char(64)
  rpId         String
  signCount    Int       @default(0)
  label        String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A short-lived grant to set up one user's wallet in a browser. Only a hash of the opaque token is stored.
model WalletSetupSession {
  id        String            @id @db.Uuid
  userId    String            @db.Uuid
  tokenHash String            @unique @db.Char(64)
  status    WalletSetupStatus @default(PENDING)
  expiresAt DateTime          @db.Timestamptz(3)
  usedAt    DateTime?         @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// The 4-digit transaction PIN state of one user. Only an Argon2id hash is stored. Attempts are counted
/// in a single atomic UPDATE, so guessing is bounded no matter how many requests arrive at once.
model TransactionPinSecurity {
  id             String    @id @db.Uuid
  userId         String    @unique @db.Uuid
  pinHash        String
  failedAttempts Int       @default(0)
  lockLevel      Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(3)
  changedAt      DateTime  @db.Timestamptz(3)
  resetRequired  Boolean   @default(false)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// The short-lived UI interaction in which a person enters their PIN for one priced payment. Created
/// without a token; the secure link is issued at render time and only its SHA-256 is stored.
model AuthorizationSession {
  id             String                     @id @db.Uuid
  userId         String                     @db.Uuid
  walletId       String                     @db.Uuid
  intentId       String                     @db.Uuid
  intentRevision Int
  routeId        String                     @db.Uuid
  tokenHash      String?                    @unique @db.Char(64)
  tokenIssuedAt  DateTime?                  @db.Timestamptz(3)
  status         AuthorizationSessionStatus @default(PENDING)
  expiresAt      DateTime                   @db.Timestamptz(3)
  usedAt         DateTime?                  @db.Timestamptz(3)
  cancelReason   String?
  createdAt      DateTime                   @default(now()) @db.Timestamptz(3)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet                Wallet                 @relation(fields: [walletId], references: [id], onDelete: Restrict)
  intent                Intent                 @relation(fields: [intentId], references: [id], onDelete: Restrict)
  route                 Route                  @relation(fields: [routeId], references: [id], onDelete: Restrict)
  paymentAuthorizations PaymentAuthorization[]

  @@index([userId, status])
  @@index([intentId, status])
}

/// The durable, immutable record of WHAT a person approved: bounded amounts, parties, assets and
/// route shape, bound to an intent revision. Not a provider quote. Short-lived and single-use.
/// Amounts are canonical smallest-unit strings: EXACT_INPUT spends at most maxInputAmount (the
/// authorized input) and must receive at least minOutputAmount; EXACT_OUTPUT must deliver at least
/// minOutputAmount (the exact output) for at most maxInputAmount.
model PaymentAuthorization {
  id                 String                     @id @db.Uuid
  userId             String                     @db.Uuid
  walletId           String                     @db.Uuid
  intentId           String                     @db.Uuid
  intentRevision     Int
  routeId            String                     @db.Uuid
  sessionId          String?                    @db.Uuid
  status             PaymentAuthorizationStatus @default(ACTIVE)
  operation          IntentType
  chainId            Int
  recipientId        String?                    @db.Uuid
  recipientAddress   String?
  destinationCountry String?
  amountMode         AmountMode
  inputAssetId       String                     @db.Uuid
  outputAssetId      String                     @db.Uuid
  maxInputAmount     String
  minOutputAmount    String
  routeAssetPath     String[]                   @db.Uuid
  routeProviders     String[]
  expiresAt          DateTime                   @db.Timestamptz(3)
  consumedAt         DateTime?                  @db.Timestamptz(3)
  revokedAt          DateTime?                  @db.Timestamptz(3)
  revocationReason   String?
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  intent            Intent                @relation(fields: [intentId], references: [id], onDelete: Restrict)
  route             Route                 @relation(fields: [routeId], references: [id], onDelete: Restrict)
  session           AuthorizationSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  firmQuoteAttempts FirmQuoteAttempt[]
  executions        Execution[]
  inputAsset        Asset                 @relation("AuthorizationInputAsset", fields: [inputAssetId], references: [id], onDelete: Restrict)
  outputAsset       Asset                 @relation("AuthorizationOutputAsset", fields: [outputAssetId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([intentId, status])
}

/// Encrypted execution material (a provider claim token). Only AES-256-GCM ciphertext is stored; the
/// key lives in the environment, never in the database.
model ExecutionSecret {
  id         String   @id @db.Uuid
  purpose    String
  keyVersion Int
  ciphertext String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  firmQuoteAttempts FirmQuoteAttempt[]
}

/// One request for a firm provider quote, recorded BEFORE the provider is called so retries and
/// duplicates can never spend another provider slot. History is kept.
model FirmQuoteAttempt {
  id                     String                 @id @db.Uuid
  paymentAuthorizationId String                 @db.Uuid
  userId                 String                 @db.Uuid
  walletId               String                 @db.Uuid
  providerId             String                 @db.Uuid
  status                 FirmQuoteAttemptStatus @default(REQUESTING)
  idempotencyKey         String                 @unique
  amountMode             AmountMode
  exactAmount            String
  exactAssetId           String                 @db.Uuid
  takerAddress           String
  providerQuoteId        String?
  inputAmount            String?
  inputAssetId           String?                @db.Uuid
  outputAmount           String?
  outputAssetId          String?                @db.Uuid
  feeAmount              String?
  feeAssetId             String?                @db.Uuid
  reactor                String?
  spender                String?
  expiresAt              DateTime?              @db.Timestamptz(3)
  orderDeadline          DateTime?              @db.Timestamptz(3)
  latestOrderDeadline    DateTime?              @db.Timestamptz(3)
  /// The provider's unsigned approval and swap transactions. Contains no secret.
  unsignedTransactions   Json?
  claimSecretId          String?                @db.Uuid
  failureCode            String?
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(3)

  paymentAuthorization PaymentAuthorization @relation(fields: [paymentAuthorizationId], references: [id], onDelete: Restrict)
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet               Wallet               @relation(fields: [walletId], references: [id], onDelete: Restrict)
  provider             Provider             @relation(fields: [providerId], references: [id], onDelete: Restrict)
  claimSecret          ExecutionSecret?     @relation(fields: [claimSecretId], references: [id], onDelete: Restrict)
  exactAsset           Asset                @relation("FirmExactAsset", fields: [exactAssetId], references: [id], onDelete: Restrict)
  inputAsset           Asset?               @relation("FirmInputAsset", fields: [inputAssetId], references: [id], onDelete: Restrict)
  outputAsset          Asset?               @relation("FirmOutputAsset", fields: [outputAssetId], references: [id], onDelete: Restrict)
  feeAsset             Asset?               @relation("FirmFeeAsset", fields: [feeAssetId], references: [id], onDelete: Restrict)
  executions           Execution[]

  @@index([paymentAuthorizationId, status])
  @@index([providerId, status])
}

/// A one-time, short-lived WebAuthn challenge. Claimed with a single UPDATE so a replay gets nothing.
model PasskeyChallenge {
  id        String                  @id @db.Uuid
  userId    String                  @db.Uuid
  purpose   PasskeyChallengePurpose
  challenge String                  @unique
  expiresAt DateTime                @db.Timestamptz(3)
  usedAt    DateTime?               @db.Timestamptz(3)
  createdAt DateTime                @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// A constrained, expiring permission for Kaada's delegated signer. There is no "anything" form:
/// contracts, assets, a per-transaction limit and an expiry are mandatory (checks in the manual
/// migration). `enforcement` records, per constraint, whether the account enforces it on chain or
/// only Kaada's code does.
model DelegatedPermission {
  id                    String           @id @db.Uuid
  userId                String           @db.Uuid
  walletId              String           @db.Uuid
  provider              String
  providerPermissionId  String?
  chainId               Int
  status                PermissionStatus @default(PENDING)
  allowedOperations     String[]
  allowedContracts      String[]
  allowedAssetIds       String[]         @db.Uuid
  perTransactionAmount  String
  perTransactionAssetId String           @db.Uuid
  cumulativeAmount      String?
  cumulativeAssetId     String?          @db.Uuid
  enforcement           Json
  validFrom             DateTime         @db.Timestamptz(3)
  expiresAt             DateTime         @db.Timestamptz(3)
  revokedAt             DateTime?        @db.Timestamptz(3)
  revocationReason      String?
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)

  user                User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet              Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  perTransactionAsset Asset  @relation("PermissionPerTransactionAsset", fields: [perTransactionAssetId], references: [id], onDelete: Restrict)
  cumulativeAsset     Asset? @relation("PermissionCumulativeAsset", fields: [cumulativeAssetId], references: [id], onDelete: Restrict)

  @@index([walletId, status])
  @@index([userId])
}

// ───────────────────────────── Assets ─────────────────────────────

/// Fiat currencies, native coins and tokens. `decimals` defines how every smallest-unit money
/// string referencing this asset is interpreted.
///
/// Identity rules (see the `money_and_asset_constraints` migration):
/// - FIAT:   unique(fiatCode) among FIAT rows; no chainId/contractAddress.
/// - Native: exactly one row per chainId with contractAddress NULL.
/// - Tokens: unique(chainId, contractAddress) below; addresses are stored lowercase.
model Asset {
  id              String    @id @db.Uuid
  symbol          String
  name            String
  kind            AssetKind
  chainId         Int?
  contractAddress String?
  decimals        Int       @db.SmallInt
  fiatCode        String?   @db.Char(3)
  countryCode     String?   @db.Char(2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  // Back-relations only (no columns). Every asset reference in the schema is a real foreign key
  // with onDelete: Restrict; assets are deactivated (isActive), never deleted.
  intentsAsSource           Intent[]               @relation("IntentSourceAsset")
  intentsAsDestination      Intent[]               @relation("IntentDestinationAsset")
  intentsAsPreferredSource  Intent[]               @relation("IntentPreferredSourceAsset")
  recipientsPreferring      Recipient[]            @relation("RecipientPreferredAsset")
  capabilitiesAsInput       ProviderCapability[]   @relation("CapabilityInputAsset")
  capabilitiesAsOutput      ProviderCapability[]   @relation("CapabilityOutputAsset")
  quotesAsInput             Quote[]                @relation("QuoteInputAsset")
  quotesAsOutput            Quote[]                @relation("QuoteOutputAsset")
  quotesAsFee               Quote[]                @relation("QuoteFeeAsset")
  authorizationsAsInput     PaymentAuthorization[] @relation("AuthorizationInputAsset")
  authorizationsAsOutput    PaymentAuthorization[] @relation("AuthorizationOutputAsset")
  firmAttemptsAsExact       FirmQuoteAttempt[]     @relation("FirmExactAsset")
  firmAttemptsAsInput       FirmQuoteAttempt[]     @relation("FirmInputAsset")
  firmAttemptsAsOutput      FirmQuoteAttempt[]     @relation("FirmOutputAsset")
  firmAttemptsAsFee         FirmQuoteAttempt[]     @relation("FirmFeeAsset")
  routesAsInput             Route[]                @relation("RouteInputAsset")
  routesAsOutput            Route[]                @relation("RouteOutputAsset")
  routesAsFee               Route[]                @relation("RouteFeeAsset")
  routeStepsAsInput         RouteStep[]            @relation("RouteStepInputAsset")
  routeStepsAsOutput        RouteStep[]            @relation("RouteStepOutputAsset")
  transactionsAsTransferred Transaction[]          @relation("TransactionAsset")
  transactionsAsGas         Transaction[]          @relation("TransactionGasAsset")
  rampSessions              RampSession[]
  permissionsPerTransaction DelegatedPermission[]  @relation("PermissionPerTransactionAsset")
  permissionsCumulative     DelegatedPermission[]  @relation("PermissionCumulativeAsset")

  // Postgres treats NULLs as distinct, so this only constrains tokens (both columns set);
  // fiat and native rows are covered by the partial indexes in the manual migration.
  @@unique([chainId, contractAddress])
  @@index([kind, isActive])
  @@index([symbol])
}

// ─────────────────────── Conversations ───────────────────────

model Conversation {
  id                     String             @id @db.Uuid
  userId                 String             @db.Uuid
  channel                ChannelType
  status                 ConversationStatus @default(ACTIVE)
  externalConversationId String?
  metadata               Json?
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages             Message[]
  intents              Intent[]
  clarificationOptions ClarificationOption[]

  // One conversation per external chat. NULLs are distinct, so channels without an external id
  // (e.g. WEB) are unaffected.
  @@unique([channel, externalConversationId])
  @@index([userId, status])
}

model Message {
  id                String      @id @db.Uuid
  conversationId    String      @db.Uuid
  role              MessageRole
  content           String
  externalMessageId String?
  structuredData    Json?
  metadata          Json?
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Webhook de-duplication: the same external message cannot be stored twice per conversation.
  // Messages without an external id (assistant/system/tool) are never constrained.
  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
}

// ───────────────────────────── Intents ─────────────────────────────

model Intent {
  id                     String       @id @db.Uuid
  userId                 String       @db.Uuid
  conversationId         String       @db.Uuid
  type                   IntentType
  status                 IntentStatus @default(DRAFT)
  /// Smallest-unit integer string. Unresolved human decimals belong in normalizedData instead.
  amount                 String?
  amountMode             AmountMode?
  sourceAssetId          String?      @db.Uuid
  destinationAssetId     String?      @db.Uuid
  recipientId            String?      @db.Uuid
  destinationCountry     String?      @db.Char(2)
  /// Explicit funding preference ("use USDT"). Distinct from the human currency of `amount`.
  preferredSourceAssetId String?      @db.Uuid
  /// Bumped on every financial change. Derived state (clarification options now; quotes and routes
  /// later) binds to the revision it was made from and is stale once it moves on.
  revision               Int          @default(1)
  normalizedData         Json         @default("{}")
  constraints            Json?
  missingFields          Json?
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(3)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  conversation          Conversation           @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sourceAsset           Asset?                 @relation("IntentSourceAsset", fields: [sourceAssetId], references: [id], onDelete: Restrict)
  destinationAsset      Asset?                 @relation("IntentDestinationAsset", fields: [destinationAssetId], references: [id], onDelete: Restrict)
  recipient             Recipient?             @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  preferredSourceAsset  Asset?                 @relation("IntentPreferredSourceAsset", fields: [preferredSourceAssetId], references: [id], onDelete: Restrict)
  clarificationOptions  ClarificationOption[]
  quotes                Quote[]
  routes                Route[]
  executions            Execution[]
  authorizationSessions AuthorizationSession[]
  paymentAuthorizations PaymentAuthorization[]

  @@index([userId, status])
  @@index([conversationId])
  @@index([recipientId])
}

/// One selectable answer to a clarification question. The row, never the client payload, is the
/// source of truth: a choice is honoured only while it belongs to the conversation's open intent at
/// the same revision, is part of the latest question, is unexpired and unused. `value` holds what the
/// choice means (a resolved recipient, an asset) and is never sent to the channel.
model ClarificationOption {
  id             String    @id @db.Uuid
  /// Options created for one question share a group; the newest group is the active question.
  groupId        String    @db.Uuid
  conversationId String    @db.Uuid
  intentId       String    @db.Uuid
  revision       Int
  field          String
  label          String
  description    String?
  value          Json
  expiresAt      DateTime  @db.Timestamptz(3)
  usedAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  intent       Intent       @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@index([intentId, createdAt])
  @@index([groupId])
}

model Recipient {
  id                 String        @id @db.Uuid
  ownerUserId        String?       @db.Uuid
  linkedUserId       String?       @db.Uuid
  type               RecipientType
  displayName        String?
  identifier         String?
  walletAddress      String?
  destinationCountry String?       @db.Char(2)
  preferredAssetId   String?       @db.Uuid
  isSaved            Boolean       @default(false)
  metadata           Json?
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)

  owner          User?    @relation("RecipientOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  linkedUser     User?    @relation("RecipientLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  preferredAsset Asset?   @relation("RecipientPreferredAsset", fields: [preferredAssetId], references: [id], onDelete: Restrict)
  intents        Intent[]

  @@index([ownerUserId, isSaved])
  @@index([linkedUserId])
  @@index([type, identifier])
}

// ───────────────────────────── Providers ─────────────────────────────

/// Provider registry. Credentials never live in the database.
model Provider {
  id        String       @id @db.Uuid
  slug      String       @unique
  name      String
  type      ProviderType
  isActive  Boolean      @default(true)
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  capabilities      ProviderCapability[]
  quotes            Quote[]
  routeSteps        RouteStep[]
  rampSessions      RampSession[]
  firmQuoteAttempts FirmQuoteAttempt[]
}

/// Data-driven corridor support: what a provider can do, for which assets/chain/country.
/// Nothing is assumed supported unless a row says so. The nullable columns make a natural
/// composite unique key impossible; the manual migration 20261011000000 adds an expression index
/// (NULL-safe) that makes duplicates impossible.
model ProviderCapability {
  id            String         @id @db.Uuid
  providerId    String         @db.Uuid
  capability    CapabilityType
  chainId       Int?
  inputAssetId  String?        @db.Uuid
  outputAssetId String?        @db.Uuid
  countryCode   String?        @db.Char(2)
  isActive      Boolean        @default(true)
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  inputAsset  Asset?   @relation("CapabilityInputAsset", fields: [inputAssetId], references: [id], onDelete: Restrict)
  outputAsset Asset?   @relation("CapabilityOutputAsset", fields: [outputAssetId], references: [id], onDelete: Restrict)

  @@index([providerId, capability, isActive])
  @@index([inputAssetId, outputAssetId])
}

// ───────────────────── Quotes, routes (immutable snapshots) ─────────────────────

/// Immutable snapshot of a provider price. A changed price is a new row; there is no updatedAt.
model Quote {
  id              String    @id @db.Uuid
  intentId        String    @db.Uuid
  intentRevision  Int
  providerId      String    @db.Uuid
  inputAssetId    String    @db.Uuid
  outputAssetId   String    @db.Uuid
  inputAmount     String
  outputAmount    String
  feeAmount       String?
  feeAssetId      String?   @db.Uuid
  slippageBps     Int?
  providerQuoteId String?
  expiresAt       DateTime? @db.Timestamptz(3)
  rawProviderData Json?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  intent      Intent      @relation(fields: [intentId], references: [id], onDelete: Restrict)
  provider    Provider    @relation(fields: [providerId], references: [id], onDelete: Restrict)
  inputAsset  Asset       @relation("QuoteInputAsset", fields: [inputAssetId], references: [id], onDelete: Restrict)
  outputAsset Asset       @relation("QuoteOutputAsset", fields: [outputAssetId], references: [id], onDelete: Restrict)
  feeAsset    Asset?      @relation("QuoteFeeAsset", fields: [feeAssetId], references: [id], onDelete: Restrict)
  routeSteps  RouteStep[]

  @@index([intentId, createdAt])
  @@index([providerId, providerQuoteId])
}

/// Snapshot of a candidate path. Only `status` is expected to change after creation.
model Route {
  id              String      @id @db.Uuid
  intentId        String      @db.Uuid
  intentRevision  Int
  status          RouteStatus @default(CREATED)
  inputAssetId    String      @db.Uuid
  outputAssetId   String      @db.Uuid
  estimatedInput  String
  estimatedOutput String
  totalFeeAmount  String?
  totalFeeAssetId String?     @db.Uuid
  expiresAt       DateTime?   @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  intent                Intent                 @relation(fields: [intentId], references: [id], onDelete: Restrict)
  inputAsset            Asset                  @relation("RouteInputAsset", fields: [inputAssetId], references: [id], onDelete: Restrict)
  outputAsset           Asset                  @relation("RouteOutputAsset", fields: [outputAssetId], references: [id], onDelete: Restrict)
  totalFeeAsset         Asset?                 @relation("RouteFeeAsset", fields: [totalFeeAssetId], references: [id], onDelete: Restrict)
  steps                 RouteStep[]
  executions            Execution[]
  authorizationSessions AuthorizationSession[]
  paymentAuthorizations PaymentAuthorization[]

  @@index([intentId, status])
  @@index([intentId, intentRevision, status])
}

model RouteStep {
  id            String        @id @db.Uuid
  routeId       String        @db.Uuid
  position      Int
  type          RouteStepType
  providerId    String?       @db.Uuid
  inputAssetId  String        @db.Uuid
  outputAssetId String        @db.Uuid
  inputAmount   String
  outputAmount  String
  quoteId       String?       @db.Uuid
  metadata      Json?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  route       Route     @relation(fields: [routeId], references: [id], onDelete: Restrict)
  provider    Provider? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  inputAsset  Asset     @relation("RouteStepInputAsset", fields: [inputAssetId], references: [id], onDelete: Restrict)
  outputAsset Asset     @relation("RouteStepOutputAsset", fields: [outputAssetId], references: [id], onDelete: Restrict)
  quote       Quote?    @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@unique([routeId, position])
  @@index([quoteId])
}

// ───────────────────── Execution & settlement ─────────────────────

model Execution {
  id                     String          @id @db.Uuid
  intentId               String          @db.Uuid
  routeId                String          @db.Uuid
  userId                 String          @db.Uuid
  status                 ExecutionStatus @default(CREATED)
  /// Durable, globally unique: a retried request can never create a second execution.
  idempotencyKey         String          @unique
  confirmedAt            DateTime?       @db.Timestamptz(3)
  startedAt              DateTime?       @db.Timestamptz(3)
  completedAt            DateTime?       @db.Timestamptz(3)
  failedAt               DateTime?       @db.Timestamptz(3)
  failureCode            String?
  failureMessage         String?
  metadata               Json?
  /// Set for a payment execution plan (Build 12): one per payment authorization.
  paymentAuthorizationId String?         @unique @db.Uuid
  walletId               String?         @db.Uuid
  firmQuoteAttemptId     String?         @db.Uuid
  /// The serialized ExecutionPlan. Holds no secret, signature or claim token.
  plan                   Json?
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)

  intent               Intent                @relation(fields: [intentId], references: [id], onDelete: Restrict)
  route                Route                 @relation(fields: [routeId], references: [id], onDelete: Restrict)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions         Transaction[]
  paymentAuthorization PaymentAuthorization? @relation(fields: [paymentAuthorizationId], references: [id], onDelete: Restrict)
  wallet               Wallet?               @relation(fields: [walletId], references: [id], onDelete: Restrict)
  firmQuoteAttempt     FirmQuoteAttempt?     @relation(fields: [firmQuoteAttemptId], references: [id], onDelete: Restrict)
  auditEvents          AuditEvent[]

  @@index([intentId])
  @@index([routeId])
  @@index([userId, status])
  @@index([status, createdAt])
}

model Transaction {
  id          String            @id @db.Uuid
  executionId String            @db.Uuid
  type        TransactionType
  status      TransactionStatus @default(CREATED)
  chainId     Int
  hash        String?
  fromAddress String?
  toAddress   String?
  assetId     String?           @db.Uuid
  /// Smallest-unit integer strings; never JS numbers.
  amount      String?
  gasAmount   String?
  gasAssetId  String?           @db.Uuid
  nonce       String?
  metadata    Json?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  execution Execution @relation(fields: [executionId], references: [id], onDelete: Restrict)
  asset     Asset?    @relation("TransactionAsset", fields: [assetId], references: [id], onDelete: Restrict)
  gasAsset  Asset?    @relation("TransactionGasAsset", fields: [gasAssetId], references: [id], onDelete: Restrict)

  // hash is NULL until broadcast (NULLs are distinct), and unique per chain once present.
  @@unique([chainId, hash])
  @@index([executionId])
  @@index([status])
}

/// A fiat on/off-ramp session. Works for hosted redirects (redirectUrl) and API-driven sessions
/// (externalSessionId); neither is required.
model RampSession {
  id                 String     @id @db.Uuid
  userId             String     @db.Uuid
  providerId         String     @db.Uuid
  type               RampType
  status             RampStatus @default(CREATED)
  assetId            String     @db.Uuid
  amount             String?
  countryCode        String?    @db.Char(2)
  destinationAddress String?
  externalSessionId  String?
  redirectUrl        String?
  metadata           Json?
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([providerId, externalSessionId])
  @@index([userId, status])
}

/// Append-only by application convention (no updatedAt, no deletes).
model AuditEvent {
  id          String   @id @db.Uuid
  userId      String?  @db.Uuid
  executionId String?  @db.Uuid
  type        String
  entityType  String?
  entityId    String?  @db.Uuid
  data        Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user      User?      @relation(fields: [userId], references: [id], onDelete: Restrict)
  execution Execution? @relation(fields: [executionId], references: [id], onDelete: Restrict)

  @@index([executionId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
