{
  "name": "kaada",
  "version": "0.0.0",
  "private": true,
  "description": "Agentic cross-border payment router on Celo.",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kaada/database generate",
    "db:validate": "pnpm --filter @kaada/database db:validate",
    "db:migrate": "pnpm --filter @kaada/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @kaada/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @kaada/database db:migrate:status",
    "db:seed": "pnpm --filter @kaada/database db:seed",
    "db:studio": "pnpm --filter @kaada/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.7"
  }
}
